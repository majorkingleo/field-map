{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: field-map",
      "type": "shell",
      "command": "npm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "detail": "Typecheck (tsc --noEmit) then bundle src/main.ts -> dist/app.js + dist/app.css"
    },
    {
      "label": "watch: field-map",
      "type": "shell",
      "command": "npm run watch",
      "isBackground": true,
      "problemMatcher": ["$tsc-watch"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "detail": "Rebuild dist/ on every src/ change (run alongside the Apache-hosted page)."
    }
  ]
}
